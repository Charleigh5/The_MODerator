{
  "name": "moderator-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "gauntlet": "tsc -p tsconfig.gauntlet.json && node tests/gauntlet.mjs && node tests/gameplay-lab.mjs && node tests/filter-asset-inventory.mjs && node tests/ai-orchestrator.mjs && node tests/siwc-core.mjs && node tests/madden-studio.mjs && node tests/studio-plan.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "framer-motion": "^11.16.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0",
    "source-map-js": "^1.2.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  },
  "version": "0.1.0",
  "description": "Madden NFL 27 PC mod studio and local Windows verification companion",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.charleigh5.moderator",
    "productName": "MODerator Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MODerator-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MODerator-Desktop-Portable-${version}.${ext}"
    },
    "npmRebuild": false
  },
  "author": "Charleigh5",
  "license": "MIT"
}
